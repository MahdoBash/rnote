<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="RnCanvasWrapper" parent="GtkWidget">
    <property name="layout-manager">
      <object class="GtkBoxLayout" />
    </property>
    <property name="hexpand">true</property>
    <property name="vexpand">true</property>
    <property name="halign">fill</property>
    <property name="valign">fill</property>
    <child>
      <object class="GtkOverlay">
        <child>
          <object class="GtkScrolledWindow" id="scroller">
            <style>
              <class name="canvas_scroller" />
            </style>
            <property name="propagate-natural-width">false</property>
            <property name="propagate-natural-height">false</property>
            <property name="halign">fill</property>
            <property name="valign">fill</property>
            <property name="vexpand">true</property>
            <property name="hexpand">true</property>
            <property name="window-placement">bottom-right</property>
            <property name="overlay-scrolling">true</property>
            <child>
              <object class="RnCanvas" id="canvas">
                <property name="halign">center</property>
                <property name="valign">start</property>
                <child>
                  <object class="RnContextMenu" id="contextmenu"></object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child type="overlay">
          <object class="GtkRevealer" id="page_indicator">
            <property name="halign">end</property>
            <property name="valign">start</property>
            <property name="margin-end">24</property>
            <property name="margin-start">24</property>
            <property name="margin-top">16</property>
            <property name="margin-bottom">16</property>
            <property name="transition-type">crossfade</property>
            <property name="transition-duration">180</property>
            <child>
              <object class="GtkMenuButton" id="page_indicator_button">
                <property name="tooltip-text" translatable="yes">Go to Page</property>
                <property name="popover">
                  <object class="GtkPopover" id="page_indicator_popover">
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">12</property>
                        <property name="margin-top">12</property>
                        <property name="margin-bottom">12</property>
                        <property name="margin-start">12</property>
                        <property name="margin-end">12</property>
                        <child>
                          <object class="GtkLabel">
                            <property name="label" translatable="yes">Go to Page</property>
                            <style><class name="heading" /></style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkSpinButton" id="page_number_spin">
                            <property name="tooltip-text" translatable="yes">Page Number</property>
                            <property name="numeric">true</property>
                            <property name="digits">0</property>
                            <property name="width-chars">6</property>
                            <property name="adjustment">
                              <object class="GtkAdjustment">
                                <property name="lower">1</property>
                                <property name="upper">1</property>
                                <property name="step-increment">1</property>
                                <property name="page-increment">10</property>
                                <property name="value">1</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="page_go_button">
                            <property name="label" translatable="yes">Go</property>
                            <style><class name="suggested-action" /></style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </property>
                <property name="child">
                  <object class="GtkLabel" id="page_indicator_label" />
                </property>
                <style><class name="osd" /><class name="page-indicator" /></style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
